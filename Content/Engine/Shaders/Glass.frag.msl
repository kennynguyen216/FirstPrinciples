static inline __attribute__((always_inline))
float3 ApplyNormalMap(thread const float3& normal, thread const float4& tangent, thread const float3& sampled, thread const float& strength)
{
    float3 n = fast::normalize(normal);
    float3 t = fast::normalize(tangent.xyz - (n * dot(n, tangent.xyz)));
    float3 b = cross(n, t) * tangent.w;
    float3 local = (sampled * 2.0) - float3(1.0);
