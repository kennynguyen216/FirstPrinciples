    float2 _123 = _121.xy * strength;
    local.x = _123.x;
    local.y = _123.y;
    return fast::normalize(((t * local.x) + (b * local.y)) + (n * local.z));
}

static inline __attribute__((always_inline))
float3 ViewDirection(thread const float3& worldPosition, constant FrameData& Frame)
{
    if (Frame.CameraPosition.w > 0.5)
    {
        return -fast::normalize(Frame.CameraForward.xyz);
    }
    return fast::normalize(Frame.CameraPosition.xyz - worldPosition);
}

static inline __attribute__((always_inline))
float3 FresnelSchlick(thread const float& cosTheta, thread const float3& f0)
{
    return f0 + ((float3(1.0) - f0) * powr(1.0 - cosTheta, 5.0));
}

static inline __attribute__((always_inline))
void GetLight(thread const int& i, thread const float3& worldPosition, thread float3& toLight, thread float3& radiance, constant FrameData& Frame)
{
    float4 position = Frame.LightPosition[i];
    float4 color = Frame.LightColor[i];
    if (position.w < 0.5)
    {
        toLight = -fast::normalize(position.xyz);
        radiance = color.xyz;
        return;
    }
    float3 delta = position.xyz - worldPosition;
    float _distance = length(delta);
    toLight = delta / float3(fast::max(_distance, 9.9999997473787516355514526367188e-05));
    float ratio = _distance / fast::max(color.w, 9.9999997473787516355514526367188e-05);
    float window = fast::clamp(1.0 - (((ratio * ratio) * ratio) * ratio), 0.0, 1.0);
    radiance = ((color.xyz * window) * window) / float3((_distance * _distance) + 1.0);
}

static inline __attribute__((always_inline))
float DistributionGGX(thread const float& nDotH, thread const float& roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float d = ((nDotH * nDotH) * (a2 - 1.0)) + 1.0;
    return a2 / ((3.1415927410125732421875 * d) * d);
}

static inline __attribute__((always_inline))
float VisibilitySmith(thread const float& nDotV, thread const float& nDotL, thread const float& roughness)
{
    float k = ((roughness + 1.0) * (roughness + 1.0)) / 8.0;
    float gv = nDotV / ((nDotV * (1.0 - k)) + k);
    float gl = nDotL / ((nDotL * (1.0 - k)) + k);
    return (gv * gl) / fast::max((4.0 * nDotV) * nDotL, 9.9999997473787516355514526367188e-05);
}

static inline __attribute__((always_inline))
float3 SpecularOnly(thread const float3& n, thread const float3& v, thread const float3& l, thread const float3& radiance, thread const float& roughness, thread const float3& f0)
{
    float3 h = fast::normalize(v + l);
    float nDotL = fast::max(dot(n, l), 0.0);
    float nDotV = fast::max(dot(n, v), 9.9999997473787516355514526367188e-05);
    float nDotH = fast::max(dot(n, h), 0.0);
    float param = fast::max(dot(h, v), 0.0);
    float3 param_1 = f0;
    float3 f = FresnelSchlick(param, param_1);
    float param_2 = nDotH;
    float param_3 = roughness;
    float param_4 = nDotV;
    float param_5 = nDotL;
    float param_6 = roughness;
    return (((f * (DistributionGGX(param_2, param_3) * VisibilitySmith(param_4, param_5, param_6))) * radiance) * nDotL) * 3.1415927410125732421875;
}

