#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FXAAData
{
    float4 Params;
};

struct main0_out
{
    float4 OutColor [[color(0)]];
};

struct main0_in
{
    float2 InUV [[user(locn0)]];
};

static inline __attribute__((always_inline))
float Luma(thread const float3& color)
{
    return sqrt(fast::max(dot(color, float3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625)), 0.0));
}

fragment main0_out main0(main0_in in [[stage_in]], constant FXAAData& FXAA [[buffer(0)]], texture2d<float> Source [[texture(0)]], sampler SourceSmplr [[sampler(0)]])
{
    main0_out out = {};
    float2 pixel = FXAA.Params.xy;
    float3 center = Source.sample(SourceSmplr, in.InUV).xyz;
    float3 param = Source.sample(SourceSmplr, (in.InUV + (pixel * float2(-1.0)))).xyz;
    float nw = Luma(param);
    float3 param_1 = Source.sample(SourceSmplr, (in.InUV + (pixel * float2(1.0, -1.0)))).xyz;
    float ne = Luma(param_1);
    float3 param_2 = Source.sample(SourceSmplr, (in.InUV + (pixel * float2(-1.0, 1.0)))).xyz;
    float sw = Luma(param_2);
    float3 param_3 = Source.sample(SourceSmplr, (in.InUV + (pixel * float2(1.0)))).xyz;
    float se = Luma(param_3);
    float3 param_4 = center;
    float middle = Luma(param_4);
    float low = fast::min(middle, fast::min(fast::min(nw, ne), fast::min(sw, se)));
    float high = fast::max(middle, fast::max(fast::max(nw, ne), fast::max(sw, se)));
    if ((high - low) < fast::max(0.031199999153614044189453125, high * 0.125))
    {
        out.OutColor = float4(center, 1.0);
        return out;
    }
    float2 direction = float2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
    float reduce = fast::max((((nw + ne) + sw) + se) * 0.03125, 0.0078125);
    direction = fast::clamp(direction / float2(fast::min(abs(direction.x), abs(direction.y)) + reduce), float2(-8.0), float2(8.0)) * pixel;
    float3 a = (Source.sample(SourceSmplr, (in.InUV + (direction * (-0.16666667163372039794921875)))).xyz + Source.sample(SourceSmplr, (in.InUV + (direction * 0.16666667163372039794921875))).xyz) * 0.5;
    float3 b = (a * 0.5) + ((Source.sample(SourceSmplr, (in.InUV - (direction * 0.5))).xyz + Source.sample(SourceSmplr, (in.InUV + (direction * 0.5))).xyz) * 0.25);
    float3 param_5 = b;
    float lumaB = Luma(param_5);
    out.OutColor = float4(select(b, a, bool3((lumaB < low) || (lumaB > high))), 1.0);
    return out;
}
