#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct MaterialData
{
    float4 BaseColor;
    float4 Emissive;
    float4 Subsurface;
    float4 Params;
    float4 Params2;
    float4 Style;
};

struct FrameData
{
    float4 CameraPosition;
    float4 CameraForward;
    float4 CameraRight;
    float4 CameraUp;
    float4 Ambient;
    float4 ScreenSize;
    int4 LightCount;
    float4 LightPosition[16];
    float4 LightColor[16];
    float4 LightDirection[16];
    float4 LightCone[16];
    float4x4 ShadowMatrix[8];
    float4 ShadowParams[3];
    float4 EnvironmentParams;
    float4 EnvironmentSize;
    float4 EnvironmentDiffuse[9];
};

struct main0_out
{
    float4 OutColor [[color(0)]];
};

struct main0_in
{
    float2 InUV [[user(locn1)]];
    float4 InTint [[user(locn4)]];
};

static inline __attribute__((always_inline))
bool IsCelShaded(constant MaterialData& Material)
{
    return Material.Style.x > 0.5;
}

static inline __attribute__((always_inline))
float3 CelBands(thread const float3& color)
{
    float brightness = dot(fast::max(color, float3(0.0)), float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    if (brightness <= 9.9999997473787516355514526367188e-06)
    {
        return float3(0.0);
    }
    float band = floor((sqrt(brightness) * 4.0) + 0.5) / 4.0;
    return color * ((band * band) / brightness);
}

fragment main0_out main0(main0_in in [[stage_in]], constant MaterialData& Material [[buffer(0)]], texture2d<float> BaseColorMap [[texture(0)]], sampler BaseColorMapSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 color = (BaseColorMap.sample(BaseColorMapSmplr, in.InUV) * Material.BaseColor) * in.InTint;
    if (color.w < Material.Params2.y)
    {
        discard_fragment();
    }
    if (IsCelShaded(Material))
    {
        float3 param = color.xyz;
        float3 _104 = CelBands(param);
        color.x = _104.x;
        color.y = _104.y;
        color.z = _104.z;
    }
    out.OutColor = float4(color.xyz + Material.Emissive.xyz, color.w);
    return out;
}

