};

struct EmitterBuffer
{
    LEmitter Emitters[1];
};

struct LLight
{
    float4 Position;
    float4 ColorRange;
    float4 DirectionInner;
    float4 OuterRadius;
};

struct LightBuffer
{
    LLight Lights[1];
};

