static inline __attribute__((always_inline))
float3 ApplyNormalMap(thread const float3& normal, thread const float4& tangent, thread const float3& sampled, thread const float& strength)
{
    float3 n = fast::normalize(normal);
    float3 t = fast::normalize(tangent.xyz - (n * dot(n, tangent.xyz)));
    float3 b = cross(n, t) * tangent.w;
    float3 local = (sampled * 2.0) - float3(1.0);
    float3 _170 = local;
    float2 _172 = _170.xy * strength;
    local.x = _172.x;
    local.y = _172.y;
    return fast::normalize(((t * local.x) + (b * local.y)) + (n * local.z));
}

static inline __attribute__((always_inline))
float3 ViewDirection(thread const float3& worldPosition, constant FrameData& Frame)
{
    if (Frame.CameraPosition.w > 0.5)
    {
        return -fast::normalize(Frame.CameraForward.xyz);
    }
    return fast::normalize(Frame.CameraPosition.xyz - worldPosition);
}

static inline __attribute__((always_inline))
float3 FresnelSchlick(thread const float& cosTheta, thread const float3& f0)
{
    return f0 + ((float3(1.0) - f0) * powr(1.0 - cosTheta, 5.0));
}

static inline __attribute__((always_inline))
bool IsCelShaded(constant MaterialData& Material)
{
    return Material.Style.x > 0.5;
}

static inline __attribute__((always_inline))
float3 CelBands(thread const float3& color)
{
    float brightness = dot(fast::max(color, float3(0.0)), float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
    if (brightness <= 9.9999997473787516355514526367188e-06)
    {
        return float3(0.0);
    }
    float band = floor((sqrt(brightness) * 4.0) + 0.5) / 4.0;
    return color * ((band * band) / brightness);
}

static inline __attribute__((always_inline))
float3 EnvironmentDirection(thread const float3& direction, thread const float& rotation)
{
    float c = cos(rotation);
    float s = sin(rotation);
    return float3((c * direction.x) - (s * direction.z), direction.y, (s * direction.x) + (c * direction.z));
}

static inline __attribute__((always_inline))
float3 EnvironmentPixel(thread int2& pixel, thread const int2& size, thread const int& offset, const device EnvironmentData& Environment)
{
    pixel.x = spvSMod(spvSMod(pixel.x, size.x) + size.x, size.x);
    pixel.y = clamp(pixel.y, 0, size.y - 1);
    return Environment.Pixels[(offset + (pixel.y * size.x)) + pixel.x].xyz;
}

static inline __attribute__((always_inline))
float3 EnvironmentLevel(thread const float3& direction, thread const int& level0, thread const float4& dimensions, const device EnvironmentData& Environment)
{
    int2 size = int2(dimensions.xy);
    int offset = 0;
    for (int i = 0; i < level0; i++)
    {
        offset += (size.x * size.y);
        size = max((size / int2(2)), int2(1));
    }
    float2 uv = float2((precise::atan2(direction.z, direction.x) / 6.283185482025146484375) + 0.5, acos(fast::clamp(direction.y, -1.0, 1.0)) / 3.1415927410125732421875);
    float2 coordinate = (uv * float2(size)) - float2(0.5);
    int2 pixel = int2(floor(coordinate));
    float2 f = fract(coordinate);
    int2 param = pixel;
    int2 param_1 = size;
    int param_2 = offset;
    float3 _602 = EnvironmentPixel(param, param_1, param_2, Environment);
    int2 param_3 = pixel + int2(1, 0);
    int2 param_4 = size;
    int param_5 = offset;
    float3 _611 = EnvironmentPixel(param_3, param_4, param_5, Environment);
    int2 param_6 = pixel + int2(0, 1);
    int2 param_7 = size;
    int param_8 = offset;
    float3 _624 = EnvironmentPixel(param_6, param_7, param_8, Environment);
    int2 param_9 = pixel + int2(1);
    int2 param_10 = size;
    int param_11 = offset;
    float3 _632 = EnvironmentPixel(param_9, param_10, param_11, Environment);
    return mix(mix(_602, _611, float3(f.x)), mix(_624, _632, float3(f.x)), float3(f.y));
}

static inline __attribute__((always_inline))
float3 EnvironmentRadiance(thread const float3& direction, thread const float& roughness, thread const float4& dimensions, const device EnvironmentData& Environment)
{
    float level0 = fast::clamp(roughness, 0.0, 1.0) * (dimensions.z - 1.0);
    int low = int(floor(level0));
    int high = min((low + 1), (int(dimensions.z) - 1));
    float3 param = direction;
    int param_1 = low;
    float4 param_2 = dimensions;
    float3 param_3 = direction;
    int param_4 = high;
    float4 param_5 = dimensions;
    return mix(EnvironmentLevel(param, param_1, param_2, Environment), EnvironmentLevel(param_3, param_4, param_5, Environment), float3(fract(level0)));
}

static inline __attribute__((always_inline))
float3 EnvironmentReflection(thread const float3& normal, thread const float3& view, thread const float& roughness, constant FrameData& Frame, const device EnvironmentData& Environment)
{
    float3 param = reflect(-view, normal);
    float param_1 = Frame.EnvironmentParams.y;
    float3 direction = EnvironmentDirection(param, param_1);
    float3 param_2 = direction;
    float param_3 = roughness;
    float4 param_4 = Frame.EnvironmentSize;
    return EnvironmentRadiance(param_2, param_3, param_4, Environment) * Frame.EnvironmentParams.x;
}

static inline __attribute__((always_inline))
void GetLight(thread const int& i, thread const float3& worldPosition, thread float3& toLight, thread float3& radiance, constant FrameData& Frame)
{
    float4 position = Frame.LightPosition[i];
    float4 color = Frame.LightColor[i];
    if (position.w < 0.5)
    {
        toLight = -fast::normalize(position.xyz);
        radiance = color.xyz;
        return;
    }
    float3 delta = position.xyz - worldPosition;
    float _distance = length(delta);
    toLight = delta / float3(fast::max(_distance, 9.9999997473787516355514526367188e-05));
    float ratio = _distance / fast::max(color.w, 9.9999997473787516355514526367188e-05);
    float window = fast::clamp(1.0 - (((ratio * ratio) * ratio) * ratio), 0.0, 1.0);
    radiance = ((color.xyz * window) * window) / float3((_distance * _distance) + 1.0);
    if (position.w > 1.5)
    {
        float cosine = dot(-toLight, fast::normalize(Frame.LightDirection[i].xyz));
        float2 cone = Frame.LightCone[i].xy;
        radiance *= smoothstep(cone.y, fast::max(cone.x, cone.y + 9.9999997473787516355514526367188e-05), cosine);
    }
}

static inline __attribute__((always_inline))
float DistributionGGX(thread const float& nDotH, thread const float& roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float d = ((nDotH * nDotH) * (a2 - 1.0)) + 1.0;
    return a2 / ((3.1415927410125732421875 * d) * d);
}

static inline __attribute__((always_inline))
float VisibilitySmith(thread const float& nDotV, thread const float& nDotL, thread const float& roughness)
{
    float k = ((roughness + 1.0) * (roughness + 1.0)) / 8.0;
    float gv = nDotV / ((nDotV * (1.0 - k)) + k);
    float gl = nDotL / ((nDotL * (1.0 - k)) + k);
    return (gv * gl) / fast::max((4.0 * nDotV) * nDotL, 9.9999997473787516355514526367188e-05);
}

static inline __attribute__((always_inline))
float3 SpecularOnly(thread const float3& n, thread const float3& v, thread const float3& l, thread const float3& radiance, thread const float& roughness, thread const float3& f0)
{
    float3 h = fast::normalize(v + l);
    float nDotL = fast::max(dot(n, l), 0.0);
    float nDotV = fast::max(dot(n, v), 9.9999997473787516355514526367188e-05);
    float nDotH = fast::max(dot(n, h), 0.0);
    float param = fast::max(dot(h, v), 0.0);
    float3 param_1 = f0;
    float3 f = FresnelSchlick(param, param_1);
    float param_2 = nDotH;
    float param_3 = roughness;
    float param_4 = nDotV;
    float param_5 = nDotL;
    float param_6 = roughness;
    return (((f * (DistributionGGX(param_2, param_3) * VisibilitySmith(param_4, param_5, param_6))) * radiance) * nDotL) * 3.1415927410125732421875;
}

static inline __attribute__((always_inline))
float CelEdge(thread const float& nDotV)
{
    return mix(0.1500000059604644775390625, 1.0, step(0.180000007152557373046875, nDotV));
}

fragment main0_out main0(main0_in in [[stage_in]], constant MaterialData& Material [[buffer(0)]], constant FrameData& Frame [[buffer(1)]], const device EnvironmentData& Environment [[buffer(2)]], texture2d<float> BaseColorMap [[texture(0)]], texture2d<float> NormalMap [[texture(1)]], texture2d<float> RoughnessMap [[texture(2)]], texture2d<float> SceneColor [[texture(3)]], sampler BaseColorMapSmplr [[sampler(0)]], sampler NormalMapSmplr [[sampler(1)]], sampler RoughnessMapSmplr [[sampler(2)]], sampler SceneColorSmplr [[sampler(3)]], float4 gl_FragCoord [[position]])
