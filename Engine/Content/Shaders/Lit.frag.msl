        float3 param_23 = n;
        float3 param_24 = v;
        float param_25 = roughness;
        float3 param_26 = f0;
        float param_27 = roughness;
        float param_28 = nDotV;
        float3 specularLight = EnvironmentReflection(param_23, param_24, param_25, Frame, Environment) * EnvironmentBRDF(param_26, param_27, param_28);
        diffuseLighting += (diffuse * occlusion);
        specularLighting += (specularLight * occlusion);
    }
    if (IsCelShaded(Material))
    {
        float3 param_29 = diffuseLighting;
        diffuseLighting = CelBands(param_29);
        float3 param_30 = specularLighting;
        specularLighting = CelBands(param_30);
    }
    float3 color = (diffuseColor * diffuseLighting) + specularLighting;
    if (IsCelShaded(Material))
    {
        float param_31 = fast::max(dot(faceNormal, v), 0.0);
        color *= CelEdge(param_31);
    }
    color += (EmissiveMap.sample(EmissiveMapSmplr, in.InUV).xyz * Material.Emissive.xyz);
    out.OutColor = float4(color, base.w);
    return out;
}
