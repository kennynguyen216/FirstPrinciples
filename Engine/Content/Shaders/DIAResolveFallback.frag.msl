};

struct TexelBuffer
{
    uint4 Texels[1];
};

struct LEmitter
{
    uint4 Identity;
    uint4 Geometry;
    float4 Distribution;
};

struct EmitterBuffer
{
    LEmitter Emitters[1];
};

struct LLight
{
    float4 Position;
    float4 ColorRange;
    float4 DirectionInner;
    float4 OuterRadius;
};

struct LightBuffer
{
    LLight Lights[1];
};

