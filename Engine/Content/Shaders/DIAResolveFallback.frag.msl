};

struct LInstance
{
    float4x4 Transform;
    float4x4 Inverse;
    uint4 Geometry;
    uint4 Metadata;
    uint4 Identity;
    float4 Tint;
};

struct InstanceBuffer
{
    LInstance Instances[1];
};

struct LMaterial
{
    float4 BaseColor;
    float4 Emission;
    float4 Parameters;
    float4 Parameters2;
    float4 UVTransform;
    uint4 Textures[8];
