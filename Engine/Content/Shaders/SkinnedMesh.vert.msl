#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct BoneData
{
    float4x4 Matrices[128];
};

struct ObjectData
{
    float4x4 ViewProjection;
    float4x4 Model;
    float4x4 NormalMatrix;
    float4 UVTransform;
    float4 Tint;
};

struct main0_out
{
    float3 OutWorldPosition [[user(locn0)]];
    float2 OutUV [[user(locn1)]];
    float3 OutNormal [[user(locn2)]];
    float4 OutTangent [[user(locn3)]];
    float4 OutTint [[user(locn4)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 InPosition [[attribute(0)]];
    float3 InNormal [[attribute(1)]];
    float2 InUV [[attribute(2)]];
    float4 InTangent [[attribute(3)]];
    uint4 InBones [[attribute(4)]];
    float4 InWeights [[attribute(5)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant ObjectData& Object [[buffer(0)]], constant BoneData& Bones [[buffer(1)]])
{
    main0_out out = {};
    float4x4 _34 = Bones.Matrices[in.InBones.x] * in.InWeights.x;
    float4x4 _42 = Bones.Matrices[in.InBones.y] * in.InWeights.y;
    float4x4 _55 = float4x4(_34[0] + _42[0], _34[1] + _42[1], _34[2] + _42[2], _34[3] + _42[3]);
    float4x4 _63 = Bones.Matrices[in.InBones.z] * in.InWeights.z;
    float4x4 _76 = float4x4(_55[0] + _63[0], _55[1] + _63[1], _55[2] + _63[2], _55[3] + _63[3]);
    float4x4 _84 = Bones.Matrices[in.InBones.w] * in.InWeights.w;
    float4x4 skin = float4x4(_76[0] + _84[0], _76[1] + _84[1], _76[2] + _84[2], _76[3] + _84[3]);
    float4 world = Object.Model * (skin * float4(in.InPosition, 1.0));
    out.OutWorldPosition = world.xyz;
    out.OutUV = (in.InUV * Object.UVTransform.xy) + Object.UVTransform.zw;
    out.OutNormal = fast::normalize(float3x3(Object.NormalMatrix[0].xyz, Object.NormalMatrix[1].xyz, Object.NormalMatrix[2].xyz) * (float3x3(skin[0].xyz, skin[1].xyz, skin[2].xyz) * in.InNormal));
    out.OutTangent = float4(fast::normalize(float3x3(Object.Model[0].xyz, Object.Model[1].xyz, Object.Model[2].xyz) * (float3x3(skin[0].xyz, skin[1].xyz, skin[2].xyz) * in.InTangent.xyz)), in.InTangent.w);
    out.OutTint = Object.Tint;
    out.gl_Position = Object.ViewProjection * world;
    return out;
}

