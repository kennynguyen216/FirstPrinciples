static inline __attribute__((always_inline))
float3 EnvironmentDirection(thread const float3& direction, thread const float& rotation)
{
    float c = cos(rotation);
    float s = sin(rotation);
    return float3((c * direction.x) - (s * direction.z), direction.y, (s * direction.x) + (c * direction.z));
}

static inline __attribute__((always_inline))
float3 EnvironmentPixel(thread int2& pixel, thread const int2& size, thread const int& offset, const device EnvironmentData& Environment)
{
    pixel.x = spvSMod(spvSMod(pixel.x, size.x) + size.x, size.x);
    pixel.y = clamp(pixel.y, 0, size.y - 1);
    return Environment.Pixels[(offset + (pixel.y * size.x)) + pixel.x].xyz;
}

